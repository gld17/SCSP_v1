              let memGb = NaN;
              try {
                applyRegistryModel(name);
                renderConfigInputs();
                readConfigFromInputs();
                const c = buildConfigForSimulation({});
                const ret = await apiPost("/api/simulations/single", { config: c, bandwidth_gbps: bw });
                const m = ret?.metrics;
                const v = Number(m?.single_star_peak_memory_gb ?? m?.prefill_peak_memory_gb);
                if (Number.isFinite(v)) memGb = v;
              } catch {
                toast("后端仿真接口调用失败，请检查服务状态", { type: "error" });
                memGb = NaN;
              }
              if (!Number.isFinite(memGb)) {
                if (isDev) memGb = 6 + mi * 5;
              }
              rows.push({
                model: colLabels[mi],
                model_name: name,
                single_star_peak_memory_gb: memGb
              });
            }
            applyRegistryModel(restoreModel);
            renderConfigInputs();
            readConfigFromInputs();
            copyMainCfgToMirrorInputs();
          } else {
            rows = mockRows.slice();
          showResult({ error: String(e) });
        }
      };
      byId("btnRunSweep").onclick = async () => {
        try {
          const overviewBtn = document.querySelector('.nav-btn[data-page="overview"]');
          if (overviewBtn) overviewBtn.click();
          readConfigFromInputs();
          await runSensitivityExperiments();
          state.overviewResultsDisplayed = true;
          const ret = {
            mode: "overview_sensitivity",
            bandwidth_rows: getBandwidthSensitivityRows(),
            compute_rows: getComputeSensitivityRows()
          };
          showResult(ret);
        } catch {
          toast("后端仿真接口调用失败，请检查服务状态", { type: "error" });
          state.overviewResultsDisplayed = true;
          readConfigFromInputs();
          if (isDev) {
            const sbw = state.config.link_bandwidth_gbps_single;
            state.kpiOverviewRow = mockRows.find((r) => r.link_bandwidth_gbps === sbw) || mockRows[Math.min(2, mockRows.length - 1)];
            state.sweepRows = mockRows;
            state.bandwidthSensitivityRows = mockRows;
            state.computeSensitivityRows = [];
            showResult({ warning: "后端接口不可用，已回退 mock 数据。" });
          } else {
            showResult({ error: "后端接口不可用" });
          }
          renderAll();
        }
      };
      byId("btnSaveExperiment").onclick = async () => {
        try {
          readConfigFromInputs();
          const ret = await apiPost("/api/experiments/run", { config: state.config, template_name: "bandwidth_sensitivity" });
          showResult(ret);
        } catch (e) {
          showResult({ error: String(e) });
        }
      };

      (async function init() {
        await loadModelRegistry();
