<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SCSP 仿真平台</title>
    <style>
      :root {
        --bg-0: #071022;
        --bg-1: #0b1730;
        --card: rgba(13, 27, 55, 0.92);
        --line: rgba(127, 160, 215, 0.26);
        --txt: #eaf2ff;
        --txt-dim: #a8bddf;
        --blue: #5aa9ff;
        --cyan: #67d5ff;
        --green: #3bd083;
        --orange: #f5a24f;
        --red: #ec6868;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        color: var(--txt);
        font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
        background: radial-gradient(1200px 600px at 15% -10%, rgba(42, 94, 194, 0.35), transparent 55%),
                    radial-gradient(900px 500px at 95% -10%, rgba(26, 128, 170, 0.25), transparent 60%),
                    linear-gradient(180deg, var(--bg-0), var(--bg-1) 45%, #061125);
      }
      .app { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; align-items: stretch; }
      .sidebar {
        background: radial-gradient(700px 320px at 10% 10%, rgba(34, 90, 177, 0.18), transparent 60%),
                    linear-gradient(180deg, rgba(6, 16, 34, 0.99), rgba(6, 15, 31, 0.97));
        border-right: 1px solid rgba(129, 162, 220, 0.2);
        padding: 0;
        position: sticky;
        top: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .side-logo {
        min-height: 92px;
        padding: 16px 20px 14px;
        border-bottom: 1px solid rgba(126, 163, 224, 0.18);
      }
      .brand { display: flex; align-items: flex-start; gap: 10px; margin: 0; }
      .brand-logo {
        width: 34px; height: 34px; border-radius: 10px;
        background: linear-gradient(135deg, #1e6bff, #6ec1ff);
        box-shadow: 0 0 16px rgba(58, 139, 255, 0.35);
      }
      .brand h1 { margin: 0; font-size: 30px; line-height: 1; }
      .brand .name-cn {
        margin: 0;
        font-size: clamp(21px, 2.4vw, 28px);
        font-weight: 700;
        letter-spacing: 0.2px;
        white-space: nowrap;
        line-height: 1.15;
      }
      .brand .sub {
        margin-top: 3px;
        font-size: 11px;
        color: rgba(244, 247, 251, 0.72);
        line-height: 1.3;
      }
      .nav {
        padding: 12px 12px 10px;
        overflow-y: auto;
        flex: 1;
      }
      .nav-group {
        margin-bottom: 10px;
        border-top: 1px solid rgba(126, 163, 224, 0.14);
        padding-top: 10px;
      }
      .nav-group:first-child {
        border-top: 0;
        padding-top: 0;
      }
      .group-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: rgba(244, 247, 251, 0.86);
        font-size: 16px;
        font-weight: 560;
        padding: 8px 8px 6px;
      }
      .nav-btn {
        width: 100%; text-align: left; border-radius: 12px; margin: 4px 0;
        border: 1px solid transparent; background: transparent; color: #c7d9f6;
        padding: 10px 12px; cursor: pointer; font-size: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .nav-btn:hover {
        background: rgba(42, 78, 145, 0.2);
        color: #f4f7fb;
      }
      .nav-btn.active {
        border-color: rgba(95, 155, 255, 0.5);
        background: linear-gradient(90deg, rgba(30, 107, 255, 0.9), rgba(58, 139, 255, 0.8));
        color: #f6fbff;
        box-shadow: 0 8px 18px rgba(30, 107, 255, 0.25);
      }
      .nav-sub {
        margin-left: 8px;
        padding-left: 8px;
      }
      .nav-icon {
        width: 16px;
        height: 16px;
        border: 1.5px solid rgba(206, 223, 251, 0.9);
        border-radius: 4px;
        position: relative;
        flex-shrink: 0;
      }
      .nav-icon::after {
        content: "";
        position: absolute;
        width: 6px;
        height: 1.5px;
        background: rgba(206, 223, 251, 0.9);
        left: 4px;
        top: 7px;
      }
      .sidebar-user {
        border-top: 1px solid rgba(126, 163, 224, 0.18);
        padding: 14px 14px 16px;
      }
      .user-card {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: linear-gradient(145deg, rgba(85, 119, 175, 0.9), rgba(46, 74, 122, 0.9));
        border: 1px solid rgba(126, 163, 224, 0.35);
      }
      .user-name {
        font-size: 15px;
        color: #f4f7fb;
      }
      .user-state {
        margin-top: 1px;
        font-size: 12px;
        color: rgba(244, 247, 251, 0.78);
      }
      .main {
        padding: 14px 18px 18px;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        min-width: 0;
      }
      .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
        flex-shrink: 0;
      }
      .title { font-size: 22px; font-weight: 700; }
      .health { font-size: 12px; color: var(--txt-dim); margin-left: 12px; }
      .top-left { display: flex; align-items: center; }
      .top-right { display: flex; gap: 8px; align-items: center; }
      .btn {
        border: 1px solid var(--line);
        background: rgba(16, 34, 68, 0.9);
        color: var(--txt);
        border-radius: 10px;
        padding: 7px 12px;
        font-size: 13px;
        cursor: pointer;
      }
      .btn.primary {
        border-color: rgba(126, 177, 255, 0.6);
        background: linear-gradient(90deg, #2d75f1, #3a8cff);
      }
      .card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 12px;
      }
      .card h3 { margin: 0 0 10px; font-size: 16px; color: #dceaff; font-weight: 650; }
      .overview-row1 {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 22px;
        align-items: stretch;
        flex-shrink: 0;
        min-height: 360px;
      }
      .overview-left-col {
        display: grid;
        grid-template-rows: 1fr 1fr;
        gap: 22px;
        min-height: 0;
      }
      .overview-left-col > .card {
        min-height: 0;
        display: flex;
        flex-direction: column;
      }
      .card--kpi {
        min-height: 0;
        display: flex;
        flex-direction: column;
        height: 100%;
      }
      .grid-2 { display: grid; grid-template-columns: 0.82fr 1.2fr 1.08fr; gap: 10px; margin-top: 10px; }
      .grid-3 { display: grid; grid-template-columns: 1.2fr 1fr; gap: 10px; margin-top: 10px; }
      .page {
        display: none;
        flex: 1;
        flex-direction: column;
        min-height: 0;
        min-width: 0;
      }
      .page.active { display: flex; }
      .scene {
        height: 214px;
        border: 1px solid rgba(110, 155, 226, 0.18);
        border-radius: 12px;
        background-image: url("/assets/earth-horizon-reference.png");
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        position: relative;
        overflow: hidden;
      }
      .earth {
        position: absolute; bottom: -100px; left: 10%;
        width: 80%; height: 180px; border-radius: 50%;
        border: 1px solid rgba(91, 146, 245, 0.32);
      }
      .sat {
        position: absolute; width: 14px; height: 14px; border-radius: 50%;
        background: #79beff; box-shadow: 0 0 12px rgba(121, 190, 255, 0.9);
        transform: translate(-50%, -50%);
      }
      .sat.sat--remote {
        background: #8cc6ff;
        box-shadow: 0 0 12px rgba(140, 198, 255, 0.95);
      }
      .sat.sat--compute {
        background: #65e2d1;
        box-shadow: 0 0 12px rgba(101, 226, 209, 0.95);
      }
      .sat-label { position: absolute; font-size: 11px; color: #daebff; white-space: nowrap; }
      .line { position: absolute; border-top: 1px dashed rgba(129, 191, 255, 0.8); transform-origin: left center; }
      .line.l2 { border-top-color: rgba(99, 230, 211, 0.85); }
      .legend { margin-top: 8px; color: var(--txt-dim); font-size: 12px; }

