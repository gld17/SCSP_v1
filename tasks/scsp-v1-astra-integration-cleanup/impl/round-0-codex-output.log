        const llm = structure.llm || REGISTRY_FALLBACK_LLMS;
        const vision = structure.vision || {
          ...REGISTRY_FALLBACK_VISION,
          out_hidden_size: llm.hidden_size
        };
        const ist = profiling.inter_stage_transfer || {};
        return {
          modelParamsText: preset.model_params || toBText(Number(pc.resident_unit || 0)) || "7B",
          residentUnit: Number(pc.resident_unit || pc.unit || 7e9),
          activeUnit: Number(pc.active_unit || pc.resident_unit || pc.unit || 7e9),
