      async function loadModelRegistry() {
        const baselineClone = JSON.parse(JSON.stringify(MODEL_REGISTRY_BASELINE));
        try {
          const resp = await fetch("/configs/model_registry.json", { cache: "no-store" });
          if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
          const payload = await resp.json();
          if (payload && typeof payload === "object") {
            /* 同名模型以内嵌基线为准，避免服务端/浏览器缓存仍返回旧 profiling（如 2083.3）覆盖已更新的基线 */
            MODEL_REGISTRY = { ...payload, ...baselineClone };
          } else {
            MODEL_REGISTRY = baselineClone;
          }
        } catch {
          MODEL_REGISTRY = baselineClone;
        }
      }

      function applyRegistryModel(modelName) {
        const preset = MODEL_REGISTRY[modelName];
        if (!preset) return;
        const profiling = preset.profiling || {};
        const decodeMemoryMbFromBreakdown = decodeMemoryMbFromProfiling(profiling);
        state.config.model_name = modelName;
        state.config.model_structure = JSON.parse(JSON.stringify(preset.structure));
        const parameterCount = (preset.structure && preset.structure.parameter_count) || {};
        const residentCount = Number(parameterCount.resident_unit || parameterCount.unit || 0);
        const activeCount = Number(parameterCount.active_unit || residentCount || 0);
        state.config.model_params = preset.model_params || toBText(residentCount) || "7B";
        state.config.active_model_params = toBText(activeCount) || state.config.model_params;
        state.config.model_profiling = JSON.parse(JSON.stringify(profiling));
        state.config.flops_per_sample = Number(profiling.prefill_flops_gflops_per_patch || 6275) * 1e9;
        state.config.decode_flops_per_token = Number(profiling.decode_flops_gflops_per_token || 13.124) * 1e9;
        state.config.prefill_memory_bytes_per_patch = Number(profiling.prefill_memory_gb_per_patch || 16.57) * 1e9;
        state.config.decode_memory_bytes_per_token = decodeMemoryMbFromBreakdown * 1e6;
        const ist = profiling.inter_stage_transfer || {};
        if (ist.prefill_mb != null) {
          state.config.prefill_inter_stage_transfer_mb = Number(ist.prefill_mb);
        }
        if (ist.decode_kb != null) {
          state.config.decode_inter_stage_transfer_kb = Number(ist.decode_kb);
        }
      }

      async function apiGet(url) {
        const r = await fetch(url);
