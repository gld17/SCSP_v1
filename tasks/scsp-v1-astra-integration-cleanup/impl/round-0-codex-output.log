      }
      async function apiPost(url, payload) {
        const r = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        return r.json();
      }

      function metricsResponseToKpiRow(apiResult, linkBw, pflops) {
        const m = apiResult && apiResult.metrics;
        if (!m || !Number.isFinite(Number(m.total_latency_s))) return null;
        const unsupported = new Set(Array.isArray(apiResult.unsupported_fields) ? apiResult.unsupported_fields : []);
        const metricValue = (key) => unsupported.has(key) ? null : Number(m[key]);
        const metricText = (key) => unsupported.has(key) ? "—" : String(m[key] || "");
        return {
          total_samples: Number(m.total_samples),
          link_bandwidth_gbps: linkBw,
          single_star_pflops: pflops,
          total_latency_s: Number(m.total_latency_s),
          effective_compute_pflops: Number(m.effective_compute_pflops),
          data_tx_latency_s: metricValue("data_tx_latency_s"),
          inter_stage_latency_s: metricValue("inter_stage_latency_s"),
          stage1_compute_latency_s: metricValue("stage1_compute_latency_s"),
          stage2_compute_latency_s: metricValue("stage2_compute_latency_s"),
          compute_utilization: Number(m.compute_utilization),
          prefill_compute_time_s: metricValue("prefill_compute_time_s"),
          prefill_memory_time_s: metricValue("prefill_memory_time_s"),
          prefill_time_s: metricValue("prefill_time_s"),
          prefill_bottleneck: metricText("prefill_bottleneck"),
          prefill_peak_memory_gb: metricValue("prefill_peak_memory_gb"),
          single_star_peak_memory_gb: unsupported.has("single_star_peak_memory_gb") ? null : Number(m.single_star_peak_memory_gb ?? m.prefill_peak_memory_gb),
          decode_latency_s_per_token: metricValue("decode_latency_s_per_token"),
          decode_total_latency_s: metricValue("decode_total_latency_s"),
          decode_compute_latency_s_per_token: metricValue("decode_compute_latency_s_per_token"),
          decode_memory_latency_s_per_token: metricValue("decode_memory_latency_s_per_token"),
          decode_effective_compute_pflops: metricValue("decode_effective_compute_pflops"),
          decode_bottleneck: metricText("decode_bottleneck"),
          decode_energy_efficiency_tokens_per_j: metricValue("decode_energy_efficiency_tokens_per_j"),
          total_inference_time_s: metricValue("total_inference_time_s"),
          unsupported_fields: unsupported
        };
      }

