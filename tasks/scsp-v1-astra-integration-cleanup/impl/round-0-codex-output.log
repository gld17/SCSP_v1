      (async function init() {
        await loadModelRegistry();
        applyRegistryModel(state.config.model_name);
        bindNavigation();
        syncMainOverviewMode();
        bindPerformanceTabs();
        renderConfigInputs();
        bindConfigInputs();
        bindExperimentModule();
        readConfigFromInputs();
        try {
          const health = await apiGet("/api/health");
          byId("healthText").textContent = `API 状态：${health.status || "ok"}`;
        } catch {
          byId("healthText").textContent = "API 状态：不可用（已启用 mock 展示）";
        }
        state.overviewResultsDisplayed = false;
        state.sweepRows = [];
        state.bandwidthSensitivityRows = [];
        state.computeSensitivityRows = [];
        state.kpiOverviewRow = null;
        state.lastResult = null;
        renderAll();
      })();
    </script>

