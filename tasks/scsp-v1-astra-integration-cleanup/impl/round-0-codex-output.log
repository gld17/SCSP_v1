+def _max_dimension(value: Any, default: int) -> int:
+    text = str(value or "")
+    parts = text.lower().split("x")
+    if len(parts) != 2:
+        return default
+    try:
+        dims = [int(parts[0]), int(parts[1])]
+    except ValueError:
+        return default
+    positive_dims = [dim for dim in dims if dim > 0]
+    return max(positive_dims) if positive_dims else default
+
