            out_hidden_size: vision.out_hidden_size != null ? vision.out_hidden_size : llm.hidden_size
          },
          prefillFlops: Number(profiling.prefill_flops_gflops_per_patch || 6275),
          prefillMemGb: Number(profiling.prefill_memory_gb_per_patch || 16.57),
          decodeFlops: Number(profiling.decode_flops_gflops_per_token || 13.124),
          decodeMemGb: decodeMemoryMbFromProfiling(profiling) / 1000,
          prefillInterStageMb: Number(ist.prefill_mb ?? 2.5),
          decodeInterStageKb: Number(ist.decode_kb ?? 7.17)
        };
