      async function runSensitivityExperiments() {
        readConfigFromInputs();
        const singleBw = Math.round(Number(state.config.link_bandwidth_gbps_single));
        const singleP = Number(state.config.big_star_peak_pflops_single);
        const sweepBws = (state.config.link_bandwidth_gbps_sweep || []).map((n) => Math.round(Number(n))).filter((n) => Number.isFinite(n) && n > 0);
        const sweepPs = (state.config.big_star_peak_pflops_sweep || []).map((n) => Number(n)).filter((n) => Number.isFinite(n) && n > 0);

        state.kpiOverviewRow = null;

        try {
          const kpiCfg = buildConfigForSimulation({});
          const kpiRet = await apiPost("/api/simulations/single", {
            config: kpiCfg,
            bandwidth_gbps: singleBw
          });
          state.kpiOverviewRow = metricsResponseToKpiRow(kpiRet, singleBw, singleP);
        } catch {
          state.kpiOverviewRow = null;
        }

        const cfgForSweep = buildConfigForSimulation({});
        try {
          const bwRet = await apiPost("/api/simulations/sweep", {
            config: cfgForSweep,
            bandwidths_gbps: sweepBws.length ? sweepBws : [10, 50, 100, 200, 400]
          });
          state.bandwidthSensitivityRows = Array.isArray(bwRet.rows) && bwRet.rows.length ? bwRet.rows : [];
          state.sweepRows = state.bandwidthSensitivityRows;
        } catch {
          state.bandwidthSensitivityRows = [];
          state.sweepRows = [];
        }

        const rows = [];
        const bwForCompute = singleBw;
        const pList = sweepPs.length ? sweepPs : [0.6, 0.8, 1.0, 1.2, 1.4].map((f) => +(singleP * f).toFixed(3));
        for (const point of pList) {
          const p = Number(point);
          if (!Number.isFinite(p) || p <= 0) continue;
          try {
            const pointCfg = buildConfigForSimulation({ big_star_peak_pflops_single: p });
            const ret = await apiPost("/api/simulations/single", { config: pointCfg, bandwidth_gbps: bwForCompute });
            const latency = ret?.metrics?.total_latency_s;
            if (Number.isFinite(latency)) {
              rows.push({ single_star_pflops: p, total_latency_s: Number(latency) });
            }
          } catch {
            // ignore failed point
          }
        }
        state.computeSensitivityRows = rows.sort((a, b) => a.single_star_pflops - b.single_star_pflops);
      }

      function syncMainOverviewMode() {
        const main = byId("mainRoot");
        if (!main) return;
        const overviewActive = byId("page-overview") && byId("page-overview").classList.contains("active");
        main.classList.toggle("main--overview", overviewActive);
      }

      function bindNavigation() {
        const titleMap = {
          overview: "概览",
          constellation: "星座构型配置",
          model: "模型部署配置",
          compute: "算力节点配置",
          link: "通信链路配置",
          application: "天基应用配置",
          "experiment-design": "实验设计",
          "experiment-results": "实验结果"
        };
        const buttons = Array.from(document.querySelectorAll(".nav-btn"));
        buttons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const page = btn.dataset.page;
            const wasExpDesign = byId("page-experiment-design")?.classList.contains("active");
            buttons.forEach((b) => b.classList.toggle("active", b === btn));
            document.querySelectorAll(".page").forEach((p) => p.classList.remove("active"));
            const target = byId(`page-${page}`);
            if (target) target.classList.add("active");
            byId("pageTitle").textContent = titleMap[page] || "SCSP 仿真平台";
            syncMainOverviewMode();
            if (wasExpDesign && page !== "experiment-design") {
              pushMirrorAndExpCoreToMainDom();
              readConfigFromInputs();
              state.experiment.mirrorDomReady = false;
            }
            state.experiment.shouldHydrateMirror = page === "experiment-design";
            renderAll();
          });
        });
      }

      function bindConfigInputs() {
        const ids = [
          "cfgRemoteAlt", "cfgComputeAlt", "cfgComputeCount", "cfgInterSatDistance",
          "cfgModelName", "cfgModelParams", "cfgActiveModelParams", "cfgModelType", "cfgStructureType",
          "cfgLlmNumHiddenLayers", "cfgLlmHiddenSize", "cfgLlmIntermediateSize", "cfgLlmAttentionHeads", "cfgLlmKvHeads",
          "cfgVisionDepth", "cfgVisionHiddenSize", "cfgVisionPatchSize", "cfgVisionSpatialMerge", "cfgVisionOutHiddenSize",
          "cfgStageSplit", "cfgFlops", "cfgPrefillMemoryGB", "cfgDecodeFlopsPerToken", "cfgDecodeMemoryGB", "cfgPrefillInterStageTransfer", "cfgDecodeInterStageTransfer", "cfgImageResolution", "cfgTileSize", "cfgDecodeTokens",
          "cfgPeakPflopsSingle", "cfgPeakPflopsSweep", "cfgPrefillComputeUtil", "cfgPrefillMemoryUtil", "cfgDecodeComputeUtil", "cfgDecodeMemoryUtil", "cfgMemoryBandwidthTBps", "cfgPowerLimit", "cfgVram",
          "cfgBandwidthSingle", "cfgBandwidthSweep", "cfgLinkModeComputeInter", "cfgLinkModeRemoteCompute"
        ];
        const triggerRunSweepOnEnter = (event) => {
          if (event.key !== "Enter" || event.isComposing) return;
          event.preventDefault();
          const overviewBtn = document.querySelector('.nav-btn[data-page="overview"]');
          if (overviewBtn) overviewBtn.click();
