          } else if (tid === "compute_sweep") {
            xKey = "single_star_pflops";
            xLabel = "单星峰值算力 (PFLOPS)";
            highlightX = state.config.big_star_peak_pflops_single;
            const ps = parseExpScanList(draft.scan)
              .map((x) => Number(String(x).trim()))
              .filter((n) => Number.isFinite(n) && n > 0);
            const plist = ps.length ? ps : [6, 8, 10, 12, 14];
            const bw = Math.round(Number(state.config.link_bandwidth_gbps_single));
            for (const p of plist) {
              try {
                const pointCfg = buildConfigForSimulation({ big_star_peak_pflops_single: p });
                const ret = await apiPost("/api/simulations/single", { config: pointCfg, bandwidth_gbps: bw });
                const m = ret?.metrics;
                if (m && Number.isFinite(Number(m.total_latency_s))) rows.push({ single_star_pflops: p, ...m });
              } catch {
                /* 单点失败则跳过，后续用示意数据补齐 */
              }
            }
            if (!rows.length) {
              if (isDev) {
                const baseP = Number(state.config.big_star_peak_pflops_single) || 10;
                plist.forEach((p) => {
                  rows.push({
                    single_star_pflops: p,
                    total_latency_s: (mockRows[2].total_latency_s * baseP) / Math.max(p, 0.1)
                  });
                });
              }
            }
          } else if (tid === "inter_sat_distance") {
            xKey = "inter_sat_distance_km";
            xLabel = "星间距离 (km)";
            const dists = parseExpScanList(draft.scan)
              .map((x) => Number(String(x).trim()))
              .filter((n) => Number.isFinite(n) && n > 0);
            const distList = dists.length ? dists : [5, 10, 20, 50, 100];
            highlightX = distList[0];
            const bw = Math.round(Number(state.config.link_bandwidth_gbps_single));
            for (const dist of distList) {
              let m = null;
              try {
                const pointCfg = buildConfigForSimulation({ inter_sat_distance_km: dist });
                const ret = await apiPost("/api/simulations/single", { config: pointCfg, bandwidth_gbps: bw });
                m = ret?.metrics;
              } catch {
                toast("后端仿真接口调用失败，请检查服务状态", { type: "error" });
                m = null;
              }
              if (m && Number.isFinite(Number(m.total_latency_s))) {
                rows.push({ inter_sat_distance_km: dist, ...m });
              } else if (isDev) {
                rows.push({ inter_sat_distance_km: dist, total_latency_s: 88 + dist * 0.42 });
              }
            }
          } else if (tid === "model_scale") {
            chartType = "bar";
            heatmapSpec = null;
            xKey = "model";
            xLabel = "模型类型";
