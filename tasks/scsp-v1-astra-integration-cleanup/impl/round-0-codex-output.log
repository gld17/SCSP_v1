          const el = byId(id);
          el.addEventListener("input", onConfigValueChanged);
          el.addEventListener("change", onConfigValueChanged);
          if (el.tagName !== "TEXTAREA") el.addEventListener("keydown", triggerRunSweepOnEnter);
