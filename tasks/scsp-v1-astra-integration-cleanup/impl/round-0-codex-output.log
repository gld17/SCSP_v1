      function rowsToCsvLines(rows) {
        if (!rows.length) return [];
        const keys = Object.keys(rows[0]);
        return [keys.join(",")].concat(rows.map((r) => keys.map((k) => String(r[k] ?? "")).join(",")));
      }

      /** 实验结果页曲线 / 热力图纵轴（横轴为各模板自变量） */
      const EXP_RESULT_METRIC_SPECS = [
        { yKey: "prefill_latency_ms", yUnit: "Prefill延时 (ms)" },
        { yKey: "decode_throughput_tokens_per_s", yUnit: "Decode速度 (tokens/s)" }
      ];
      const EXP_RESULT_CURVE_CANVAS_IDS = ["expResultChart0", "expResultChart1"];
      const EXP_RESULT_HEATMAP_CANVAS_IDS = ["expHeatmapPrefill", "expHeatmapDecodeTps"];

      function extractFourQuantitiesFromMetrics(m, decodeTokens) {
        const tok = Math.max(1, Number(decodeTokens) || 1);
        const prefillS = Number(m?.prefill_time_s);
        const dlat = Number(m?.decode_latency_s_per_token);
        let decodeTotS = Number(m?.decode_total_latency_s);
        if (!Number.isFinite(decodeTotS) && Number.isFinite(dlat)) decodeTotS = dlat * tok;
        const energy = Number(m?.decode_energy_efficiency_tokens_per_j);
        const prefillMs = Number.isFinite(prefillS) ? prefillS * 1000 : NaN;
        const decodeTps = Number.isFinite(dlat) && dlat > 0 ? 1 / dlat : NaN;
        const taskPdMs =
          Number.isFinite(prefillS) && Number.isFinite(decodeTotS) ? (prefillS + decodeTotS) * 1000 : NaN;
        return {
          prefillMs: Number.isFinite(prefillMs) ? prefillMs : 0,
          decodeTps: Number.isFinite(decodeTps) ? decodeTps : 0,
          energy: Number.isFinite(energy) ? energy : 0,
          taskPdMs: Number.isFinite(taskPdMs) ? taskPdMs : 0
        };
      }

      function estimateFourFromTotalLatencyS(totalS, decodeTokens) {
        const t = Number(totalS);
        const tok = Math.max(1, Number(decodeTokens) || 1);
        if (!Number.isFinite(t) || t <= 0) {
          return { prefillMs: 0, decodeTps: 0, energy: 0, taskPdMs: 0 };
        }
        const prefillS = t * 0.38;
        const decodePerTokS = (t * 0.22) / tok;
        const decodeTotS = decodePerTokS * tok;
        const energy = decodePerTokS > 0 ? 1 / Math.max(1e-9, 200 * decodePerTokS) : 0;
        return {
          prefillMs: prefillS * 1000,
          decodeTps: decodePerTokS > 0 ? 1 / decodePerTokS : 0,
          energy,
          taskPdMs: (prefillS + decodeTotS) * 1000
        };
      }

      function normalizeExpCurveRow(row, decodeTokens) {
        if (
          Number.isFinite(Number(row.prefill_latency_ms)) &&
          Number.isFinite(Number(row.decode_throughput_tokens_per_s))
        ) {
          return row;
        }
        const hasEngine =
          Number.isFinite(Number(row.prefill_time_s)) && Number.isFinite(Number(row.decode_latency_s_per_token));
        const q = hasEngine
          ? extractFourQuantitiesFromMetrics(row, decodeTokens)
          : estimateFourFromTotalLatencyS(Number(row.total_latency_s), decodeTokens);
        return {
          ...row,
          prefill_latency_ms: q.prefillMs,
          decode_throughput_tokens_per_s: q.decodeTps
        };
      }

      function normalizeExpCurveRows(rows, decodeTokens) {
        return (rows || []).map((r) => normalizeExpCurveRow({ ...r }, decodeTokens));
      }

