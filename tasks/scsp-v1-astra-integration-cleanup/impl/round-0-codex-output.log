      /** 与 applyRegistryModel 一致：breakdown 之和（GB）×1000 为 MB 标度，否则用 decode_memory_mb_per_token */
      function decodeMemoryMbFromProfiling(profiling) {
        const p = profiling || {};
        const decodeBreakdown = p.decode_memory_breakdown_gb || null;
        if (decodeBreakdown) {
          return (
            Number(decodeBreakdown.weight_read_gb_per_token || 0) +
            Number(decodeBreakdown.kv_cache_read_gb_per_token || 0) +
            Number(decodeBreakdown.kv_cache_write_gb_per_token || 0) +
            Number(decodeBreakdown.activation_and_intermediate_gb_per_token || 0)
          ) * 1e3;
        }
        return Number(p.decode_memory_mb_per_token || 100);
      }

